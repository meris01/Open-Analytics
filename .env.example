# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings → API → publishable key. Safe to expose; RLS does the work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Tracker ----
# Rotate to invalidate every visitor hash. Keep this secret.
OA_SALT=change-me-to-a-long-random-string

# Where this dashboard is reachable. Used to build the install snippet.
NEXT_PUBLIC_APP_URL=http://localhost:3000
